# 조합 루트 문맥에서 독립 API 잠금으로 설치한다.
FROM node:24.19.0-bookworm-slim AS base
WORKDIR /app/apps/api
RUN npm install --global pnpm@12.6.0

FROM base AS build
COPY apps/api/package.json apps/api/pnpm-lock.yaml apps/api/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY apps/api ./
RUN DATABASE_URL=postgresql://build:build@127.0.0.1:1/build pnpm exec prisma generate # betterleaks:allow 사유: 연결하지 않는 빌드 주소
RUN pnpm build

FROM base AS production
COPY apps/api/package.json apps/api/pnpm-lock.yaml apps/api/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile --prod

FROM base AS runtime
ENV NODE_ENV=production
RUN groupadd --gid 10001 app && useradd --uid 10001 --gid 10001 --no-create-home app
COPY --from=production --chown=10001:10001 /app/apps/api/node_modules ./node_modules
COPY --from=build --chown=10001:10001 /app/apps/api/dist ./dist
COPY --from=build --chown=10001:10001 /app/apps/api/prisma ./prisma
COPY --from=build --chown=10001:10001 /app/apps/api/prisma.config.ts ./prisma.config.ts
COPY --from=build --chown=10001:10001 /app/apps/api/package.json ./package.json
USER 10001:10001
EXPOSE 8000
CMD ["node", "--import", "./dist/core/telemetry/register.js", "dist/main.js"]
