NODE_ENV=development
PORT=8000
DATABASE_URL=postgresql://app:app@127.0.0.1:25432/app # betterleaks:allow - public local example
REDIS_URL=redis://127.0.0.1:26379/0
JWT_SECRET=development-only-jwt-signing-key-32
IDENTIFIER_HASH_SECRET=development-only-identifier-key-32
SMTP_URL=smtp://127.0.0.1:21025
MAIL_FROM=AI Template <no-reply@example.com>
FRONTEND_URL=http://localhost:3000
MAILPIT_URL=http://127.0.0.1:28025
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=local-admin-password # betterleaks:allow - public local example

# Public signing endpoint and internal object operations are separate.
S3_ENDPOINT_URL=http://127.0.0.1:28333
S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:28333
S3_REGION=us-east-1
S3_BUCKET=app
S3_ACCESS_KEY_ID=app
S3_SECRET_ACCESS_KEY=app-secret
S3_KEY_PREFIX=
STORAGE_ALLOWED_ORIGINS=http://localhost:3000
FILE_MAX_SIZE=10485760
FILE_USER_QUOTA=1073741824
FILE_ALLOWED_TYPES=image/png,image/jpeg,image/webp,image/gif
