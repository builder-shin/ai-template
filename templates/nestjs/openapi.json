  "components": {
    "schemas": {
      "ErrorCode": {
        "type": "string",
        "enum": [
          "jsonapi.unsupported_media_type",
          "jsonapi.not_acceptable",
          "jsonapi.content_too_large",
          "jsonapi.invalid_document",
          "jsonapi.invalid_query",
          "jsonapi.unsupported_include",
          "jsonapi.unsupported_sort",
          "validation.required",
          "validation.too_short",
          "validation.too_long",
          "validation.invalid_format",
          "validation.out_of_range",
          "validation.invalid_choice",
          "validation.already_taken",
          "auth.unauthenticated",
          "auth.invalid_credentials",
          "auth.token_expired",
          "auth.token_invalid",
          "auth.refresh_token_reused",
          "auth.oauth_code_invalid",
          "auth.reauthentication_required",
          "auth.oauth_denied",
          "auth.oauth_failed",
          "auth.email_not_verified",
          "auth.account_deactivated",
          "auth.verification_token_invalid",
          "permission.denied",
          "role.system_role_protected",
          "role.last_admin_protected",
          "resource.not_found",
          "resource.conflict",
          "post.invalid_transition",
          "file.too_large",
          "file.type_not_allowed",
          "file.upload_incomplete",
          "file.quota_exceeded",
          "rate_limit.exceeded",
          "internal.unexpected",
          "service.unavailable"
        ]
      },
      "ErrorSource": {
        "type": "object",
        "properties": {
          "pointer": { "type": "string" },
          "parameter": { "type": "string" }
        }
      },
      "ErrorObject": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "code": { "$ref": "#/components/schemas/ErrorCode" },
          "title": { "type": "string" },
          "detail": { "type": "string" },
          "source": { "$ref": "#/components/schemas/ErrorSource" },
          "meta": {
            "type": "object",
            "properties": {
              "params": { "type": "object", "unevaluatedProperties": {} }
            }
          }
        },
        "required": ["status", "code", "title"]
      },
      "ErrorDocument": {
        "type": "object",
        "properties": {
          "errors": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ErrorObject" }
          },
          "meta": {
            "type": "object",
            "properties": { "traceId": { "type": "string" } },
            "required": ["traceId"]
          }
        },
        "required": ["errors", "meta"]
      },
      "HealthReport": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["ok", "unavailable"] },
          "checks": {
            "type": "object",
            "unevaluatedProperties": {
              "type": "string",
              "enum": ["ok", "unavailable"]
            }
          }
        },
        "required": ["status", "checks"]
      },
      "PermissionCode": {
        "type": "string",
        "enum": [
          "admin:access",
          "users:read",
          "users:manage",
          "roles:read",
          "roles:manage",
          "audit-logs:read",
          "posts:create",
          "posts:manage"
        ]
      },
      "Locale": { "type": "string", "enum": ["ko", "en"] },
      "AuditLogAction": {
        "type": "string",
        "enum": [
          "session.login_succeeded",
          "session.login_failed",
          "session.all_revoked",
          "user.password_changed",
          "user.password_reset",
          "user.roles_changed",
          "user.deactivated",
          "user.reactivated",
          "user.deleted",
          "role.created",
          "role.updated",
          "role.deleted",
          "post.deleted_by_admin"
        ]
      },
      "PaginationLinks": {
        "type": "object",
        "properties": {
          "first": { "type": "string", "format": "uri-reference" },
          "prev": {
            "anyOf": [
              { "type": "string", "format": "uri-reference" },
              { "type": "null" }
            ],
            "format": "uri-reference"
          },
          "next": {
            "anyOf": [
              { "type": "string", "format": "uri-reference" },
              { "type": "null" }
            ],
            "format": "uri-reference"
          },
          "last": { "type": "string", "format": "uri-reference" }
        },
        "required": ["first", "prev", "next", "last"]
      },
      "PageMeta": {
        "type": "object",
        "properties": {
          "number": { "type": "integer", "format": "int32" },
          "size": { "type": "integer", "format": "int32" },
          "total": { "type": "integer", "format": "int32" },
          "totalPages": { "type": "integer", "format": "int32" }
        },
        "required": ["number", "size", "total", "totalPages"]
      },
      "CollectionMeta": {
        "type": "object",
        "properties": { "page": { "$ref": "#/components/schemas/PageMeta" } },
        "required": ["page"]
      },
      "PermissionAttributes": {
        "type": "object",
        "properties": {
          "description": { "type": "string" },
          "group": { "type": "string" }
        },
        "required": ["description", "group"]
      },
      "PermissionResource": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["permissions"] },
          "id": { "type": "string" },
          "attributes": { "$ref": "#/components/schemas/PermissionAttributes" }
        },
        "required": ["type", "id", "attributes"]
      },
      "PermissionCollectionDocument": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/PermissionResource" }
          },
          "links": { "$ref": "#/components/schemas/PaginationLinks" },
          "meta": { "$ref": "#/components/schemas/CollectionMeta" }
        },
        "required": ["data", "links", "meta"]
      },
      "UserStatus": {
        "type": "string",
        "enum": ["active", "deactivated", "deleted"]
      },
      "RegistrationCreateAttributes": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "minLength": 8, "maxLength": 128 },
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "locale": { "$ref": "#/components/schemas/Locale" }
        },
        "required": ["email", "password", "name"]
      },
      "RegistrationCreateDocument": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["registrations"] },
              "attributes": {
                "$ref": "#/components/schemas/RegistrationCreateAttributes"
              }
            },
            "required": ["type", "attributes"]
          }
        },
        "required": ["data"]
      },
      "RegistrationAttributes": {
        "type": "object",
        "properties": {
          "email": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["email", "createdAt"]
      },
      "RegistrationRelationships": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "data": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": { "type": "string", "enum": ["users"] },
                      "id": { "type": "string" }
                    },
                    "required": ["type", "id"]
                  },
                  { "type": "null" }
                ]
              }
            },
            "required": ["data"]
          }
        },
        "required": ["user"]
      },
      "RegistrationResource": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["registrations"] },
          "id": { "type": "string" },
          "attributes": {
            "$ref": "#/components/schemas/RegistrationAttributes"
          },
          "relationships": {
            "$ref": "#/components/schemas/RegistrationRelationships"
          }
        },
        "required": ["type", "id", "attributes", "relationships"]
      },
      "RegistrationDocument": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/components/schemas/RegistrationResource" }
        },
        "required": ["data"]
      },
      "EmailVerificationRequestCreateAttributes": {
        "type": "object",
        "properties": { "email": { "type": "string", "format": "email" } },
        "required": ["email"]
      },
      "EmailVerificationRequestCreateDocument": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["email-verification-requests"]
              },
              "attributes": {
                "$ref": "#/components/schemas/EmailVerificationRequestCreateAttributes"
              }
            },
            "required": ["type", "attributes"]
          }
        },
        "required": ["data"]
      },
      "EmailVerificationCreateAttributes": {
        "type": "object",
        "properties": { "token": { "type": "string" } },
        "required": ["token"]
      },
      "EmailVerificationCreateDocument": {
        "type": "object",
