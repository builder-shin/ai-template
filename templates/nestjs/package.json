{
  "name": "nestjs",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "fix": "prettier --write . && eslint --fix .",
    "test": "vitest run --project unit --project integration",
    "build": "nest build -b swc",
    "setup": "node scripts/setup.mjs",
    "dev": "node --import tsx scripts/dev.ts",
    "check": "tsx scripts/check/cli.ts",
    "test:e2e": "node --import tsx scripts/test-e2e.ts",
    "e2e:serve": "node --import tsx scripts/e2e-serve.ts",
    "gen": "tsx scripts/gen.ts",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:reset": "tsx scripts/db/reset.ts",
    "db:revision": "tsx scripts/db/revision.ts",
    "gen:module": "node scripts/not-yet.mjs gen:module 21"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/s3-request-presigner": "3.1149.0",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/platform-socket.io": "12.1.2",
    "@nestjs/websockets": "12.1.2",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/instrumentation-pg": "0.75.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@socket.io/redis-adapter": "8.3.0",
    "@socket.io/redis-emitter": "5.1.0",
    "argon2": "0.45.1",
    "bullmq": "6.3.12",
    "express": "5.2.1",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "nodemailer": "10.1.0",
    "pg": "8.23.1",
    "prisma": "7.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.2",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.12",
    "@types/express": "5.0.6",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.11.0",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-boundaries": "7.2.0",
    "prettier": "3.9.9",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "unplugin-swc": "2.0.0",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  }
}
