# compose app 프로필의 독립적인 공개 시험 literal이다. 실제 계정·비밀을 넣지 않는다.
APP_ENV=production
LOG_LEVEL=info
DATABASE_URL=postgresql://app:app@postgres:5432/app # betterleaks:allow 사유: compose 공개 시험의 가짜 계정·비밀
REDIS_URL=redis://valkey:6379/0
S3_ENDPOINT_URL=http://seaweedfs:8333
S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:28333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=app # betterleaks:allow 사유: compose 공개 시험의 가짜 계정·비밀
S3_SECRET_ACCESS_KEY=app-secret # betterleaks:allow 사유: compose 공개 시험의 가짜 계정·비밀
S3_BUCKET=app
STORAGE_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
FILE_MAX_SIZE=10485760
FILE_ALLOWED_TYPES=image/png,image/jpeg,image/webp,image/gif
FILE_USER_QUOTA=1073741824
JWT_SECRET=compose-app-profile-jwt-signing-key # betterleaks:allow 사유: compose 공개 시험의 가짜 계정·비밀
IDENTIFIER_HASH_SECRET=compose-app-profile-identifier-hash-key # betterleaks:allow 사유: compose 공개 시험의 가짜 계정·비밀
RECENT_LOGIN_SECONDS=600
SMTP_URL=smtp://mailpit:1025
MAIL_FROM=AI Template <no-reply@example.com>
FRONTEND_URL=http://localhost:3000
REALTIME_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
API_URL=http://localhost:8000
OAUTH_REDIRECT_URIS=http://localhost:3000/oauth/callback,aitpl-example://oauth/callback
OAUTH_GOOGLE_CLIENT_ID=local-google-client
OAUTH_GOOGLE_CLIENT_SECRET=local-google-secret # betterleaks:allow 사유: compose 공개 시험의 가짜 계정·비밀
OAUTH_GOOGLE_AUTHORIZE_URL=http://127.0.0.1:28080/google/authorize
OAUTH_GOOGLE_TOKEN_URL=http://oauth:8080/google/token
OAUTH_GOOGLE_PROFILE_URL=http://oauth:8080/google/userinfo
OAUTH_KAKAO_CLIENT_ID=local-kakao-client
OAUTH_KAKAO_CLIENT_SECRET=local-kakao-secret # betterleaks:allow 사유: compose 공개 시험의 가짜 계정·비밀
OAUTH_KAKAO_AUTHORIZE_URL=http://127.0.0.1:28080/kakao/authorize
OAUTH_KAKAO_TOKEN_URL=http://oauth:8080/kakao/token
OAUTH_KAKAO_PROFILE_URL=http://oauth:8080/kakao/userinfo
OAUTH_NAVER_CLIENT_ID=local-naver-client
OAUTH_NAVER_CLIENT_SECRET=local-naver-secret # betterleaks:allow 사유: compose 공개 시험의 가짜 계정·비밀
OAUTH_NAVER_AUTHORIZE_URL=http://127.0.0.1:28080/naver/authorize
OAUTH_NAVER_TOKEN_URL=http://oauth:8080/naver/token
OAUTH_NAVER_PROFILE_URL=http://oauth:8080/naver/userinfo
SEED_ADMIN_EMAIL=compose-admin@example.com
SEED_ADMIN_PASSWORD=compose-app-profile-admin-password # betterleaks:allow 사유: compose 공개 시험의 가짜 계정·비밀
OTEL_ENABLED=false
OTEL_SERVICE_NAME=app
OTEL_EXPORTER_OTLP_ENDPOINT=http://lgtm:4318
RATE_LIMIT_GLOBAL=1000000
RATE_LIMIT_LOGIN_IP=1000000
RATE_LIMIT_LOGIN_IDENTIFIER=1000000
RATE_LIMIT_REGISTRATION_IP=1000000
RATE_LIMIT_MAIL_IP=1000000
RATE_LIMIT_MAIL_EMAIL=1000000
RATE_LIMIT_PASSWORD_CHANGE_USER=1000000
PORT=8000
FORWARDED_ALLOW_IPS=
