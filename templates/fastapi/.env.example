# 개발용 설정. `uv run poe setup`이 .env가 없으면 이 파일을 .env로 복사한다.
# 이름은 src/app/core/config.py의 Settings 필드를 대문자로 쓴 것이다. 필드를 더하거나 빼면 이 파일도 고친다.
APP_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql+psycopg://app:app@localhost:25432/app
REDIS_URL=redis://localhost:26379/0
S3_ENDPOINT_URL=http://localhost:28333
S3_PUBLIC_ENDPOINT_URL=http://localhost:28333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=app
S3_SECRET_ACCESS_KEY=app-secret
S3_BUCKET=app
