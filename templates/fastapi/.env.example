# 개발용 설정. `uv run poe setup`이 .env가 없으면 이 파일을 .env로 복사하고, 있으면 없는 키만 이 값으로 더한다.
# 이름은 src/app/core/config.py의 Settings 필드를 대문자로 쓴 것이다. 필드를 더하거나 빼면 이 파일도 고친다.
# 호스트는 127.0.0.1로 쓴다. compose는 127.0.0.1에만 포트를 열고, Windows에서 localhost는 ::1을 먼저 시도해 연결마다 2초 늦다.
# 운영(APP_ENV=production)에서는 JWT_SECRET, IDENTIFIER_HASH_SECRET, SEED_ADMIN_PASSWORD가 이 파일의 값이면 앱이 시작하지 않는다.
APP_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql+psycopg://app:app@127.0.0.1:25432/app
REDIS_URL=redis://127.0.0.1:26379/0
S3_ENDPOINT_URL=http://127.0.0.1:28333
S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:28333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=app
S3_SECRET_ACCESS_KEY=app-secret
S3_BUCKET=app
# 파일 업로드: 최대 크기(바이트, 10 MiB)와 허용하는 MIME 타입(쉼표로 구분)
FILE_MAX_SIZE=10485760
FILE_ALLOWED_TYPES=image/png,image/jpeg,image/webp,image/gif
# 운영에서는 긴 무작위 값으로 바꾼다(예: python -c "import secrets; print(secrets.token_urlsafe(48))").
JWT_SECRET=local-development-only-jwt-signing-key
# 로그인 실패 감사 로그와 레이트 리밋 키에 쓰는 이메일 해시의 키. 운영에서는 긴 무작위 값으로 바꾼다.
IDENTIFIER_HASH_SECRET=local-development-only-identifier-hash-key
# 개발은 Mailpit(웹 화면 http://127.0.0.1:28025)이 메일을 받는다.
SMTP_URL=smtp://127.0.0.1:21025
MAIL_FROM=AI Template <no-reply@example.com>
FRONTEND_URL=http://localhost:3000
# Socket.IO 연결을 받을 브라우저 Origin(쉼표로 구분)
REALTIME_ALLOWED_ORIGINS=http://localhost:3000
# 브라우저가 보는 이 API의 주소. 소셜 로그인 제공자가 <API_URL>/api/v1/oauth/<제공자>/callback으로 돌아온다.
API_URL=http://localhost:8000
# 소셜 로그인 뒤 돌아갈 프론트 콜백 주소(쉼표로 구분). authorize의 redirectUri가 이 중 하나와 같아야 한다.
OAUTH_REDIRECT_URIS=http://localhost:3000/oauth/callback
# 소셜 로그인 제공자. 개발은 모의 OAuth 서버(compose의 oauth)를 가리킨다. 인가 주소는 브라우저가,
# 토큰과 프로필 주소는 서버가 부른다. 운영은 제공자 콘솔의 클라이언트와 아래 주석의 주소를 쓴다.
# google 운영: https://accounts.google.com/o/oauth2/v2/auth , https://oauth2.googleapis.com/token , https://openidconnect.googleapis.com/v1/userinfo
OAUTH_GOOGLE_CLIENT_ID=local-google-client
OAUTH_GOOGLE_CLIENT_SECRET=local-google-secret # betterleaks:allow 개발용 모의 서버의 값
OAUTH_GOOGLE_AUTHORIZE_URL=http://127.0.0.1:28080/google/authorize
OAUTH_GOOGLE_TOKEN_URL=http://127.0.0.1:28080/google/token
OAUTH_GOOGLE_PROFILE_URL=http://127.0.0.1:28080/google/userinfo
# kakao 운영: https://kauth.kakao.com/oauth/authorize , https://kauth.kakao.com/oauth/token , https://kapi.kakao.com/v2/user/me
OAUTH_KAKAO_CLIENT_ID=local-kakao-client
OAUTH_KAKAO_CLIENT_SECRET=local-kakao-secret # betterleaks:allow 개발용 모의 서버의 값
OAUTH_KAKAO_AUTHORIZE_URL=http://127.0.0.1:28080/kakao/authorize
OAUTH_KAKAO_TOKEN_URL=http://127.0.0.1:28080/kakao/token
OAUTH_KAKAO_PROFILE_URL=http://127.0.0.1:28080/kakao/userinfo
# naver 운영: https://nid.naver.com/oauth2/authorize , https://nid.naver.com/oauth2/token , https://openapi.naver.com/v1/nid/me
OAUTH_NAVER_CLIENT_ID=local-naver-client
OAUTH_NAVER_CLIENT_SECRET=local-naver-secret # betterleaks:allow 개발용 모의 서버의 값
OAUTH_NAVER_AUTHORIZE_URL=http://127.0.0.1:28080/naver/authorize
OAUTH_NAVER_TOKEN_URL=http://127.0.0.1:28080/naver/token
OAUTH_NAVER_PROFILE_URL=http://127.0.0.1:28080/naver/userinfo
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin-password # betterleaks:allow
# OpenTelemetry. 켜면 트레이스를 OTLP(HTTP)로 보낸다. 로컬 수집기는 observability 프로필의 Grafana LGTM이다
# (docker compose --profile observability up -d, 화면 http://127.0.0.1:23000).
OTEL_ENABLED=false
OTEL_SERVICE_NAME=app
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:24318
# 레이트 리밋: 전역과 로그인은 분당, 가입과 메일 요청과 비밀번호 변경(사용자별)은 시간당 요청 수
RATE_LIMIT_GLOBAL=600
RATE_LIMIT_LOGIN_IP=10
RATE_LIMIT_LOGIN_IDENTIFIER=5
RATE_LIMIT_REGISTRATION_IP=10
RATE_LIMIT_MAIL_IP=5
RATE_LIMIT_MAIL_EMAIL=3
RATE_LIMIT_PASSWORD_CHANGE_USER=5
# 프록시 뒤에서는 믿을 프록시 주소를 api 프로세스의 환경 변수로 준다. uvicorn이 읽는 값이라 .env로는
# 전해지지 않는다(docs/architecture.md의 "프록시 뒤에서 운영할 때").
# FORWARDED_ALLOW_IPS=10.0.0.0/8
