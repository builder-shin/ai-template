{
  "permissions": {
    "allow": [
      "Bash(uv run poe *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "PowerShell(uv run poe *)",
      "PowerShell(git status *)",
      "PowerShell(git log *)",
      "PowerShell(git diff *)",
      "PowerShell(git show *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Edit(./openapi.json)",
      "Edit(./api-style/**)",
      "Edit(./uv.lock)",
      "Bash(git push --force *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push -f *)",
      "Bash(git commit --no-verify *)",
      "Bash(git push --no-verify *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push --force-with-lease *)",
      "PowerShell(git push -f *)",
      "PowerShell(git commit --no-verify *)",
      "PowerShell(git push --no-verify *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--directory",
              "${CLAUDE_PROJECT_DIR}",
              "--frozen",
              "python",
              "-m",
              "tools.hooks.post_edit"
            ],
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--directory",
              "${CLAUDE_PROJECT_DIR}",
              "--frozen",
              "python",
              "-m",
              "tools.hooks.stop"
            ],
            "timeout": 600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--directory",
              "${CLAUDE_PROJECT_DIR}",
              "--frozen",
              "python",
              "-m",
              "tools.hooks.pre_bash"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--directory",
              "${CLAUDE_PROJECT_DIR}",
              "--frozen",
              "python",
              "-m",
              "tools.hooks.pre_edit"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--directory",
              "${CLAUDE_PROJECT_DIR}",
              "--frozen",
              "python",
              "-m",
              "tools.hooks.session_start"
            ],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
