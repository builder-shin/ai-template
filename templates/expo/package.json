{
  "name": "expo-template",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node --import tsx scripts/dev.mjs",
    "build": "node --import tsx scripts/native/build.mjs",
    "export": "node scripts/expo.mjs export",
    "check": "tsx scripts/check/cli.ts",
    "check:generated": "tsx scripts/gen.ts --check",
    "fix": "prettier --write . && eslint --fix .",
    "test": "jest",
    "test:node": "node --import tsx --test scripts/*.test.mjs scripts/*.test.ts scripts/check/*.test.ts",
    "test:e2e": "node --import tsx scripts/native/e2e.mjs",
    "test:ci:ios": "tsx scripts/native/ci-ios.mjs",
    "gen": "tsx scripts/gen.ts",
    "gen:feature": "tsx scripts/gen-feature/cli.ts",
    "tool": "tsx scripts/tools/cli.ts"
  },
  "dependencies": {
    "@expo/log-box": "58.0.12",
    "@hookform/resolvers": "6.0.0",
    "@tanstack/react-query": "5.104.5",
    "expo": "58.0.16",
    "expo-auth-session": "58.0.13",
    "expo-constants": "58.0.12",
    "expo-crypto": "58.0.7",
    "expo-dev-client": "58.0.14",
    "expo-document-picker": "58.0.4",
    "expo-file-system": "58.0.10",
    "expo-image-picker": "58.0.10",
    "expo-linking": "58.0.13",
    "expo-localization": "58.0.5",
    "expo-router": "58.0.24",
    "expo-secure-store": "58.0.2",
    "expo-splash-screen": "58.0.10",
    "expo-status-bar": "58.0.3",
    "expo-system-ui": "58.0.6",
    "expo-web-browser": "58.0.6",
    "i18next": "26.5.3",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-hook-form": "7.90.0",
    "react-i18next": "17.1.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "socket.io-client": "4.8.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "babel-preset-expo": "58.0.18",
    "eslint": "10.11.0",
    "eslint-plugin-boundaries": "7.2.0",
    "expo-doctor": "1.21.5",
    "jest": "30.5.2",
    "jest-expo": "58.0.11",
    "lefthook": "2.1.14",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "react-dom": "19.3.0",
    "test-renderer": "1.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.1",
    "yaml": "2.9.1"
  }
}
