{
  "name": "nextjs-template",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start --port 3000",
    "check": "tsx scripts/check/cli.ts",
    "check:generated": "tsx scripts/gen.ts --check",
    "fix": "prettier --write . && eslint --fix .",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "gen": "tsx scripts/gen.ts",
    "tool": "tsx scripts/tools/cli.ts"
  },
  "dependencies": {
    "jose": "6.2.12",
    "next": "16.3.7",
    "next-intl": "4.14.7",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@next/env": "16.3.7",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.7",
    "eslint-plugin-boundaries": "7.2.0",
    "lefthook": "2.1.14",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.1",
    "yaml": "2.9.1"
  }
}
